[Unit]
Description=LinuStart - web-based Debian/Ubuntu server administration panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/linustart/venv/bin/python -m linustart --config /etc/linustart/config.json
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

# --- hardening (the panel still needs root to manage the system) ---
PrivateTmp=true
ProtectHome=true
ProtectSystem=false
NoNewPrivileges=false
ReadWritePaths=/etc /var/lib/linustart /var/log/unattended-upgrades
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_ADMIN CAP_SYS_TIME CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID CAP_SYS_MODULE
SystemCallFilter=@system-service @network-io @file-system

[Install]
WantedBy=multi-user.target
